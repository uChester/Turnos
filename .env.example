# Copiar este archivo como .env y pegar la URL provista por PostgreSQL administrado.
# No subir .env al repositorio: DATABASE_URL contiene una contraseña.
# Ejemplo de formato: postgresql://usuario:contrasena@host-remoto:5432/barberia?sslmode=require
DATABASE_URL=postgresql://usuario:contrasena@host-remoto:5432/barberia?sslmode=require
DATABASE_SSL=true
PORT=3001
